# J-Quants API Authentication
# Option 1: Refresh Token (Recommended for MFA users)
JQUANTS_REFRESH_TOKEN=your_refresh_token_here

# Option 2: Email/Password (Only works without MFA)
# JQUANTS_MAIL_ADDRESS=your_email@example.com
# JQUANTS_PASSWORD=your_password

# Database Configuration
DATABASE_PATH=stock_data.db

# Google Sheets / service account
GOOGLE_SERVICE_ACCOUNT_FILE=secret_key.json
GOOGLE_SHEETS_SPREADSHEET_KEY=your_spreadsheet_id_here

# Google Custom Search
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_ID=your_google_cse_id

# BigQuery
GCP_PROJECT_ID=nisa-jquant
BQ_DATASET=stock_data
BQ_TABLE_PRICES=prices
BQ_TABLE_FUNDAMENTALS=fundamentals
